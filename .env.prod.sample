COMPOSE_FILE=compose.yaml:traefik.yaml

RESTART=always
DEBUG=True

FRONTEND_IMAGE=digipal/archetype-frontend:latest
BACKEND_IMAGE=digipal/archetype-backend:latest

# -----------------
# Traefik settings
# -----------------
NAME_ARCHETYPE_FRONT=digipal-front
HOST_ARCHETYPE_FRONT=digipal.tetras-libre.fr

HOST_ARCHETYPE_API=digipal-api.tetras-libre.fr
NAME_ARCHETYPE_API=digipal-api

HOST_ARCHETYPE_IIIF=digipal-iiif.tetras-libre.fr
NAME_ARCHETYPE_IIIF=digipal-iiif

# -----------------
# General settings
# -----------------

SECRET_KEY="CHANGE THIS TO ANY BIG RANDOM STRING!!!!"

SITE_NAME="Default Archetype"

# -----------------
# Database settings
# -----------------
# Change the username and password for improved security.
# Keep POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD aligned with DATABASE_URL.
POSTGRES_IMAGE=postgres:18.3-bookworm
POSTGRES_DB=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:password@postgres:5432/local"
PGDATA=/var/lib/postgresql/18/docker

# -----------------
# Search settings
# -----------------
# Search (Meilisearch). Meilisearch is NOT exposed on the host — only the api and
# celery containers reach it over the internal compose network at
# http://meilisearch:7700.
# - PRODUCTION: leave MEILI_ENV at its default (production), set a long random
#   MEILI_MASTER_KEY (>= 16 bytes), and configure the Django search client to send it.
# - LOCAL DEV: set MEILI_ENV=development to run without a key.
MEILI_ENV=development
MEILI_MASTER_KEY=""
MEILISEARCH_URL=http://meilisearch:7700

# -----------------
# Redis settings
# -----------------
# Redis. In production set a password (the redis container runs --requirepass).
# Redis is not exposed on the host. The api/celery containers must include the
# password in their Redis/Celery URLs, e.g.
#   CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Leave empty for local dev to keep auth disabled (matches the previous default).
REDIS_PASSWORD=""

# Container image tags. Pin to an immutable release tag (or @sha256: digest) for
# reproducible, rollback-able deploys instead of mutable :latest/:dev.
# BACKEND_IMAGE=ghcr.io/archetype-pal/backend:vX.Y.Z
# FRONTEND_IMAGE=ghcr.io/archetype-pal/frontend:vX.Y.Z


# -----------------
# IIIF settings
# -----------------
# IIIF image server (Sipi). Thumbnails in search use this; the browser must be able to load it.
# - With nginx on port 80 proxying /sipi: use http://localhost/sipi (or https://YourDomain/sipi in prod)
# - Without nginx (e.g. dev with frontend on 3401): use http://localhost:1024/ to hit Sipi directly.
# After changing IIIF_HOST, run `just reindex` from the infrastructure/ directory.
IIIF_HOST=https://digipal-iiif.tetras-libre.fr/

# SIPI hardening (read by sipi-config/sipi.config.lua via os.getenv). Set these in
# production to override the vendored stock-demo defaults. Leaving them unset keeps
# the demo values, which are publicly known; the control/admin routes are also
# denied at the nginx /sipi proxy as defense-in-depth.
# SIPI_JWT_SECRET=  # must be exactly 42 characters
# SIPI_ADMIN_USER=
# SIPI_ADMIN_PASSWORD=
# SIPI_LOGLEVEL=WARNING  # set DEBUG only for local debugging

# -----------------
# Hardening settings (consumed by the backend, not the frontend)
# -----------------

# CORS and Hosts
# Allowed hosts contains the domains that are allowed to host your server. Don't preprend with http/https.
ALLOWED_HOSTS=digipal.tetras-libre.fr,digipal-api.tetras-libre.fr

# CORS origins are the http/https + domain names that will run your frontend.
CORS_ALLOWED_ORIGINS=https://digipal.tetras-libre.fr,https://digipal-api.tetras-libre.fr,http://frontend

# CSRF origins are your django admin http/https + domains for your frontend and backend.
CSRF_TRUSTED_ORIGINS=https://digipal.tetras-libre.fr,https://digipal-api.tetras-libre.fr,http://frontend

# ----------------------------------------------------------------------

# Application configuration
ENABLE_PUBLICATIONS_APP=true
APP_NAME_MANUSCRIPTS=Manuscripts

# Model names
MODEL_DISPLAY_NAME_HISTORICAL_ITEM="Historical Item"
MODEL_DISPLAY_NAME_CATALOGUE_NUMBER="Catalogue Number"
MODEL_DISPLAY_NAME_POSITION="Position"
MODEL_DISPLAY_NAME_DATE="Date"

# Field names
FIELD_DISPLAY_NAME_HISTORICAL_ITEM_HAIR_TYPE="Hair Type"
FIELD_DISPLAY_NAME_CURRENT_ITEM_SHELFMARK=str, "Shelfmark"
FIELD_DISPLAY_NAME_DATE_MIN="Minimum weight"
FIELD_DISPLAY_NAME_DATE_MAX="Maximum weight"
FIELD_DISPLAY_LOCUS="Locus"
ITEM_IMAGE_DEFAULT_MODEL="manuscripts.HistoricalItem"
# ADMIN_HIDDEN_FIELDS={"manuscripts.HistoricalItem": []}

# Choices
HISTORICAL_ITEM_TYPES="Agreement,Charter,Letter"
HISTORICAL_ITEM_HAIR_TYPES="FHFH,FHHF,HFFH,HFHF,Mixed"
REPOSITORY_TYPES="Library,Institution,Person,Online Resource"
CHARACTER_ITEM_TYPES="Majuscule Letter,Minuscule Letter,Numeral,Punctuation,Symbol,Accent"

# --------------------------- FRONTEND CONFIGURATION ---------------------------
# Public API base URL (no trailing slash). Used for data and media.
NEXT_PUBLIC_API_URL=https://digipal-api.tetras-libre.fr

# IIIF image server (Sipi) base URL. Used for image proxy rewrites.
NEXT_PUBLIC_IIIF_UPSTREAM=https://digipal-iiif.tetras-libre.fr

# Always relevant ? Dont find so many usage
NEXT_PUBLIC_SITE_URL=https://digipal.tetras-libre.fr

DOCKER_IMAGE_HASH=production-latest
