SECRET_KEY="CHANGE THIS TO ANY BIG RANDOM STRING!!!!"
DEBUG=True
SITE_NAME="Default Archetype"

# Database
# Change the username and password for improved security.
# Keep POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD aligned with DATABASE_URL.
# Only scripts/upgrade-postgres-17-to-18.sh reads POSTGRES_IMAGE here; compose
# takes it from `.env` (default postgres:18.6-bookworm).
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL="postgresql://postgres:password@postgres:5432/local"

# Search (Meilisearch). Meilisearch is NOT exposed on the host — only the api and
# celery containers reach it over the internal compose network at
# http://meilisearch:7700.
# - PRODUCTION: set MEILI_ENV=production in `.env` (compose reads it from there,
#   not from this file, and defaults to development), set a long random
#   MEILI_MASTER_KEY (>= 16 bytes) here, and set MEILISEARCH_API_KEY to the same
#   value so the api and celery containers can authenticate.
# - LOCAL DEV: leave MEILI_ENV unset to run without a key.
MEILI_MASTER_KEY=""
MEILISEARCH_API_KEY=""

# Search auto-sync: every write to a model a search index depends on pushes an
# incremental update to Meilisearch (an msDesc area edit re-syncs only its item
# part). Defaults to true (Django's schema default) if unset here.
# Set SEARCH_AUTO_SYNC=false to pause all of it — e.g. during a bulk
# import/migration, or a Meilisearch outage — then run a manual reindex
# (`just reindex`) once writes settle.
SEARCH_AUTO_SYNC=true

# Redis. In production set a password (the redis container runs --requirepass).
# Redis is not exposed on the host. The api/celery containers must include the
# password in their Redis/Celery URLs, e.g.
#   CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Leave empty for local dev to keep auth disabled (matches the previous default).
REDIS_PASSWORD=""

# Container image tags. Pin to an immutable release tag (or @sha256: digest) for
# reproducible, rollback-able deploys instead of mutable :latest/:dev.
# BACKEND_IMAGE=ghcr.io/archetype-pal/backend:vX.Y.Z
# FRONTEND_IMAGE=ghcr.io/archetype-pal/frontend:vX.Y.Z

# IIIF image server (Sipi). Thumbnails in search use this; the browser must be able to load it.
# - With nginx on port 80 proxying /sipi: use http://localhost/sipi (or https://YourDomain/sipi in prod)
# - Without nginx (e.g. dev with frontend on 3401): use http://localhost:1024/ to hit Sipi directly.
# After changing IIIF_HOST, run `just reindex` from the infrastructure/ directory.
IIIF_HOST=http://localhost/sipi

# SIPI hardening (read by sipi-config/sipi.config.lua via os.getenv). Set these in
# `.env`, not here: the image_server service has no env_file, so compose passes
# them through from `.env`. See docs/sipi.md.
# - SIPI_JWT_SECRET: exactly 42 characters, e.g. `openssl rand -hex 21`. SIPI v10
#   refuses to start on an empty/short/stock-demo secret; if this is unset the
#   config falls back to a random per-boot secret (nothing here uses SIPI JWTs).
# - SIPI_ADMIN_USER / SIPI_ADMIN_PASSWORD: inert since SIPI v7 (the Lua runtime
#   dropped config.adminuser/password); kept only for rollback to older tags.
# SIPI's control/admin routes are also denied at the nginx /sipi proxy.
# SIPI_JWT_SECRET=
# SIPI_ADMIN_USER=
# SIPI_ADMIN_PASSWORD=
# SIPI_LOGLEVEL=WARNING  # set DEBUG only for local debugging

# Hosts for the nginx server -- Replace with your domain for API and website
DOMAIN=localhost

# CORS and Hosts
# Allowed hosts contains the domains that are allowed to host your server. Don't preprend with http/https.
# Include the api service's compose hostname (`api`) whenever the frontend does
# server-side fetches over the internal network via INTERNAL_API_URL=http://api:
# those requests arrive with `Host: api` and Django rejects them with
# DisallowedHost (a 400) otherwise, which silently empties SSR-rendered sections.
ALLOWED_HOSTS=localhost,api

# CORS origins are the http/https + domain names that will run your frontend.
CORS_ALLOWED_ORIGINS=http://localhost

# CSRF origins are your django admin http/https + domains for your frontend and backend.
CSRF_TRUSTED_ORIGINS=http://localhost

# Public website address, used for links in emails the backend sends.
# Optional: when unset, the backend uses the first CORS_ALLOWED_ORIGINS entry.
FRONTEND_URL=http://localhost

## FTP server is used to upload images to the server
FTP_USER=archetype_user
FTP_PASS=password
PASV_ADDRESS=localhost  # Change this to your custom domain
PASV_MIN_PORT=21100
PASV_MAX_PORT=21110

# ----------------------------------------------------------------------

# Application configuration
ENABLE_PUBLICATIONS_APP=true
APP_NAME_MANUSCRIPTS=Manuscripts

# Model names
MODEL_DISPLAY_NAME_HISTORICAL_ITEM="Historical Item"
MODEL_DISPLAY_NAME_CATALOGUE_NUMBER="Catalogue Number"
MODEL_DISPLAY_NAME_POSITION="Position"
MODEL_DISPLAY_NAME_DATE="Date"

# Field names
FIELD_DISPLAY_NAME_HISTORICAL_ITEM_HAIR_TYPE="Hair Type"
FIELD_DISPLAY_NAME_CURRENT_ITEM_SHELFMARK=str, "Shelfmark"
FIELD_DISPLAY_NAME_DATE_MIN="Minimum weight"
FIELD_DISPLAY_NAME_DATE_MAX="Maximum weight"
FIELD_DISPLAY_LOCUS="Locus"
ITEM_IMAGE_DEFAULT_MODEL="manuscripts.HistoricalItem"
# ADMIN_HIDDEN_FIELDS={"manuscripts.HistoricalItem": []}

# Choices
HISTORICAL_ITEM_TYPES="Agreement,Charter,Letter"
HISTORICAL_ITEM_HAIR_TYPES="FHFH,FHHF,HFFH,HFHF,Mixed"
REPOSITORY_TYPES="Library,Institution,Person,Online Resource"
CHARACTER_ITEM_TYPES="Majuscule Letter,Minuscule Letter,Numeral,Punctuation,Symbol,Accent"

# ------------------------------- AI PROGRAMME -------------------------------
# Read only by a backend built from the AI programme branch
# (archetype-pal/backend#202); a build of main ignores them. Nothing runs and
# nothing is sent anywhere until both switches below are true.
#
# The kill switch: while false, no model runs at all and the public agent
# (/api/v1/agent/ask/) answers 503.
ML_INFERENCE_ENABLED=false
# Whether corpus material may be sent to a hosted provider (OpenRouter, or
# Anthropic directly). Meant to follow the AI data policy, not yet written.
ML_HOSTED_PROVIDERS_ENABLED=false
# Spend caps over a rolling 24 hours, in millionths of the provider's currency
# (5000000 = 5.00): one for the whole site, one per signed-in user. Anonymous
# visitors to the agent count only against the site's cap; DRF_THROTTLE_AGENT_RATE
# limits them one by one. 0 means no cap, so set both before switching
# inference on.
ML_DAILY_COST_CAP_MICROS=0
ML_DAILY_COST_CAP_MICROS_PER_ACTOR=0
# OpenRouter, the default hosted provider. The key is a secret: put it in the
# host's env_file only.
ML_OPENROUTER_API_KEY=
# ML_OPENROUTER_MODEL=anthropic/claude-opus-5
# Keep false: requests go only to upstreams that do not keep prompts for training.
# ML_OPENROUTER_ALLOW_DATA_COLLECTION=false
# Comma-separated upstream names, to pin who receives the material. Empty
# allows any upstream that OpenRouter lists as not logging prompts.
# ML_OPENROUTER_ALLOWED_PROVIDERS=
# Anthropic, called directly. Its SDK reads the key from this variable.
# ANTHROPIC_API_KEY=
# ML_CLAUDE_MODEL=claude-opus-5
# The self-hosted glyph encoder (the `embedder` service, profile `ml`). Set it
# once that service runs; while empty, `embed_glyphs` cannot make vectors and
# "letters like this" finds only glyphs embedded before.
# ML_EMBEDDER_URL=http://embedder:8080
# The self-hosted reader (the `htr` service, profile `ml`). Set it once that
# service runs; while empty, `htr_baseline --provider kraken` cannot read a page.
# ML_HTR_URL=http://htr:8080
# The public agent: how often one visitor may ask, and how long it may work on
# one question. nginx gives /api/v1/ 60 seconds (`proxy_read_timeout` in
# nginx.conf and nginx.tunnel.conf), so keep the deadline below that and raise
# both together.
# DRF_THROTTLE_AGENT_RATE=10/hour
# AGENT_DEADLINE_SECONDS=50
# The palaeography tutor (/learn on the site). It calls Anthropic directly, so
# it needs ANTHROPIC_API_KEY above as well as both switches. A lesson runs on
# the celery worker for a few minutes, a turn at a time.
# LEARN_TUTOR_MODEL=claude-fable-5-1
# LEARN_TUTOR_EFFORT=high
# Who may bring a picture of their own: signed-in, anyone or nobody. Corpus
# pages are open to everyone. A picture is kept on this host and sent to
# Anthropic to write its lesson.
# LEARN_UPLOADS=signed-in
# Lessons one visitor may start a day, and questions one lesson takes.
# LEARN_DAILY_SESSIONS=10
# LEARN_QUESTIONS_PER_SESSION=20
# DRF_THROTTLE_LEARN_RATE=30/hour
# Days a lesson and its pictures are kept; the learn_prune service deletes
# them after that. The pictures are kept under storage/learn/, which nginx
# and the image server do not serve.
# LEARN_RETENTION_DAYS=30
# Seconds a lesson or an answer may run on the worker before it gives up.
# LEARN_TIME_LIMIT=1800

# --------------------------- FRONTEND CONFIGURATION ---------------------------
NEXT_PUBLIC_API_URL=http://localhost
